{
  "name": "agent-toolkit",
  "version": "0.1.0",
  "description": "One-stop shop for pi.dev extensions and skills",
  "keywords": ["pi-package"],
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*",
    "skills/*"
  ],
  "pi": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.6",
    "markdownlint-cli": "0.49.1"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.2"
    }
  },
  "files": [
    "agent-toolkit.json",
    "context/",
    "extensions/",
    "skills/",
    "scripts/agent-toolkit.mjs",
    "!context/dist/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*_test.py",
    "!**/*.test.*"
  ],
  "bin": {
    "agent-toolkit": "./scripts/agent-toolkit.mjs"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
